# Copy this file to .env and fill in your real sign keys.
# Never commit .env to version control.
HITUNE_SIGN_KEY=your-sign-key-here
HITUNE_ADMIN_SIGN_KEY=your-admin-sign-key-here
HITUNE_API_LOGS=false

# Optional: override AdMob ad unit IDs. Leave blank to use Google's test IDs.
HITUNE_ADMOB_ANDROID_BANNER_ID=
HITUNE_ADMOB_ANDROID_INTERSTITIAL_ID=
HITUNE_ADMOB_IOS_BANNER_ID=
HITUNE_ADMOB_IOS_INTERSTITIAL_ID=
